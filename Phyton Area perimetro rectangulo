# Ingresar el largo del terreno
largo = float(input("Ingrese largo del terreno: "))
# Ingresar el ancho del terreno
ancho = float(input("Ingrese ancho del terreno: "))
# Calcular el area del terreno
area = largo * ancho
# Calcular el perimetro del terreno
perimetro = 2 * (largo + ancho)
# Mostrar los resultados
print("El area del terreno es:", area)
print("El perimetro del terreno es:", perimetro)
