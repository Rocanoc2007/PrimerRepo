Algoritmo estadoEstudiante()
  Inicio
    Definir ACD, AU, APE, promedio como decimal
    promedio = 0
    Escribir "Ingrese nota ACD"
    Leer ACD
    Escribir "Ingrese nota AU"
    Leer AU
    Escribir "Ingrese nota APE"
    Leer APE
      Si ACD >= 0 y <= 10 entonces
        ACD = ACD * 0.3
      SiNo 
        Escribir "Ingrese nuevamente la nota"
      Si AU >= 0 y <= 10 entonces 
        AU = AU * 0.3
      SiNo
        Escribir "Ingrese nuevamente la nota"
      Si APE >= 0 y <= 10 entonces
        APE = APE * 0.4
      SiNo
        Escribir "Ingrese nuevamente la nota"
      FinSi
  ` promeio = ACD + AU + APE
      Si promedio >= 7 entonces
          Escribir "Estudiante Aprobado"
      SiNo
          Escibir "Estudiante reprobado"
      Fin Si
  Fin
