Algoritmo AreaPerimetro()
  Inicio
    Definir largo, ancho, area, perimetro como decimal
    Escribir "Ingrese largo del terreno"
    Leer largo
    Escribir "Ingrese ancho del terreno"
    Leer ancho
    area <- largo * ancho
    perimetro <- (2 × (largo + ancho))
    Escribir "El area del terreno es:" ,area
    Escribir "El perimetro del terreno es:" ,perimetro
  Fin
